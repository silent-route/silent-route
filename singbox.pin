# Pinned sing-box release.
#
# Silent Route ships exactly this version. The helper copies it into a
# root-owned directory and checks its sha256 before every start, so a
# modified binary is never run as root.
#
# Why pinned rather than "latest": sing-box changes its config schema between
# releases, and some changes only surface at startup, not in `sing-box check`.
#
# To bump: change the version, download both tarballs from
# https://github.com/SagerNet/sing-box/releases, run `shasum -a 256` on the
# extracted binaries, update the hashes, re-run the tests and the VM checks.

version = 1.14.3

# sha256 of the extracted `sing-box` binary, not of the tarball
darwin-amd64 = 4d63d13fe7516a5d0a76c764095238f9d51ada7bfa5d18cf5030ca3032882c68
darwin-arm64 = 28b7200074d6380006acc4f035a404c8af3dceb65dd92d7386ed92c9224e08a2
